#!/bin/sh
# pre-push hook — block direct pushes to main on ∞Life
# Installed by FR-20260425-ci-test-harness-gateway (C+D protection)
#
# Reference copy. Canonical install path: f:\∞Life\.git\hooks\pre-push
# See f:\∞Life\docs\PROTECTION_HOOK.md for reinstall instructions.

protected_branch='main'
remote="$1"

while read local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        refs/heads/$protected_branch)
            if [ "$local_sha" = "$remote_sha" ]; then
                continue
            fi
            if git merge-base --is-ancestor "$local_sha" "refs/remotes/$remote/$protected_branch" 2>/dev/null; then
                continue
            fi
            echo ""
            echo "❌ Direct push to '$protected_branch' blocked (FR-20260425)."
            echo ""
            echo "  ∞Life requires the PR + CI gateway, but GitHub free tier"
            echo "  cannot enforce this server-side on private repos."
            echo ""
            echo "  Open a PR instead, or override with --no-verify if you"
            echo "  understand the risk."
            echo ""
            exit 1
            ;;
    esac
done

exit 0
