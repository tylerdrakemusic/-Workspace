# ⊕Workspace .gitignore
# FR-20260422-gitignore-sweep

# Audio
*.wav
*.mp3
*.flac
*.aif
*.aiff
*.m4a
*.ogg

# Video
*.mp4
*.mov
*.avi
*.mkv

# Binaries / executables
*.exe
*.dll

# Large image/raw formats
*.heic
*.psd
*.raw

# Databases (SQLite / SQLCipher)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Tokens / secrets directory
tokens/

# Python
*.pyc
*.pyo
*.py[cod]
__pycache__/
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Logs
*.log
logs/

# Temp / cache
*.download
tmp/

# Environment & secrets
.env
.env.local
*.key
*.pem
secrets.*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# FR-20260423-workspace-gitignore-sweep
.playwright-mcp/
src/data/backups/
fr_dashboard_*.png

# Portal icon — regenerated by DALL-E 3 post-commit hook; not committed
src/data/portal_icon.png
src/data/portal_icon.ico

# Runtime state — regenerated on workspace open; not committed
src/config/mcp_status.json

# Loose images at workspace root (generated/playwright artifacts)
*.png

# generated dump artifacts
reports/all_diagrams_dump.txt
reports/*.html
reports/diagrams/*.svg

# Architecture-review proof is generated evidence; ledger and database records
# remain the durable proof for FR review.
proof/*
proof/architecture-review-FR-*.md

# Workspace-local git worktrees (FR-20260511-worktree-local-migration)
# Worktrees live at .worktrees/{branch-slug}/ — gitignored and IDE-excluded.
# Pre-commit hook blocks any accidental staging of these paths.
.worktrees/

