%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#1a2e3a', 'primaryTextColor': '#d0ecf8', 'edgeLabelBackground': '#0f1318', 'lineColor': '#4a7a9a'}}}%%
%% is_derived_view=false
%% Traceability.derived_views: diagrams/capital-derived-market-data.mmd, diagrams/capital-derived-trading-controls.mmd, diagrams/capital-derived-position-realization.mmd
graph TB
    Tyler([Tyler]) --> TradeGate[Trade Gate]
    Research[off-market research] --> Watchlist[watchlist observations]
    Research --> ExpertRegistry[verified financial-expert registry]
    ExpertRegistry --> ExpertContext{expert context<br/>attribution only}
    Research ==> ResearchRuns[(research_runs<br/>expert_context JSON)]
    ExpertContext ==> CapitalDB
    ExpertContext -.->|attribution suffix only| Watchlist
    Watchlist --> Review[supervised watchlist review]
    Review --> PromotionBoundary{promotion only<br/>no order execution}
    PromotionBoundary --> Pending[trade candidate<br/>approval_status=pending]
    Pending --> TradeGate
    CandidateScoring[signal and candidate scoring] --> Pending
    QuoteService[QuoteService<br/>read-only market data] --> QuoteDecision[quorum or degraded decision]
    QuoteDecision --> CapitalDB[(sigmacapital.db)]
    TradeGate --> Approval[human approval and account binding]
    Approval --> RealGate[real-money authorization gate]
    RealGate --> AccountsTrading[AccountsTradingClient]
    AccountsTrading --> Schwab[Charles Schwab API]
    TradeGate --> ReplaceService[broker-neutral replace-order service]
    ReplaceService --> ReplaceConfirm[Trade Gate explicit confirmation]
    ReplaceConfirm --> SchwabReplace[Schwab replace adapter]
    SchwabReplace --> ReplacementVerify[strict distinct replacement-ID verification]
    ReplacementVerify --> BrokerIdReconcile[current broker ID reconciliation]
    BrokerIdReconcile -.->|ambiguous| ReconciliationRequired[reconciliation_required]
    ReplacementVerify --> DuplicateFillGuard[duplicate-fill prevention]
    CapitalDB --> Backup[authenticated backup and restore]
    Backup --> Restore[isolated validation before publication]
    TradeGate --> PositionView[position realization read-only view]
    ExpertContext -.->|excluded| CandidateScoring
    ExpertContext -.->|excluded| Eligibility[eligibility and qualification]
    ExpertContext -.->|excluded| RiskScreen[risk screening]
    ExpertContext -.->|excluded| Approval
    ExpertContext -.->|excluded| TradeGate
    ExpertContext -.->|excluded from execution| AccountsTrading
    ExpertContext -.->|excluded from Schwab placement| Schwab
    PositionView -.->|cannot approve or execute| RealGate
    QuoteService -.->|excluded| RealGate
    CapitalDB -.->|parent details| MarketView[capital-derived-market-data]
    CapitalDB -.->|parent details| TradingView[capital-derived-trading-controls]
    CapitalDB -.->|parent details| PositionViewDetail[capital-derived-position-realization]
    class Tyler tyler
    class QuoteService,TradeGate,Approval,AccountsTrading,PositionView,Research,Watchlist,Review,ReplaceService,ReplaceConfirm,SchwabReplace,ReplacementVerify,BrokerIdReconcile,DuplicateFillGuard,ExpertRegistry orch
    class CandidateScoring,Eligibility,RiskScreen state
    class ExpertContext state
    class QuoteDecision,RealGate,Restore,PromotionBoundary,ReconciliationRequired state
    class CapitalDB,Pending,ResearchRuns db
    class Schwab ext
    class Backup,MarketView,TradingView,PositionViewDetail ws
classDef tyler fill:#2a1a3a,stroke:#9e4aff,color:#fff
classDef orch fill:#1a3a52,stroke:#4a9eff,color:#fff
classDef ws fill:#1a3a30,stroke:#6ad4b4,color:#d0f8ee
classDef ext fill:#3a2020,stroke:#ff7a7a,color:#ffd0d0
classDef db fill:#3a3010,stroke:#d4c050,color:#f8f0c0
classDef state fill:#1a1a1a,stroke:#888888,color:#cccccc
