%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#1a2e3a', 'primaryTextColor': '#d0ecf8', 'edgeLabelBackground': '#0f1318', 'lineColor': '#4a7a9a'}}}%%
%% is_derived_view=false
%% Traceability.derived_views: diagrams/capital-derived-market-data.mmd, diagrams/capital-derived-trading-controls.mmd, diagrams/capital-derived-position-realization.mmd
graph TB
    Tyler([Tyler]) --> TradeGate[Trade Gate]
    Research[off-market research] --> Discovery[discovery<br/>explicit list ticker symbols only]
    Discovery --> Watchlist[watchlist observations]
    Watchlist --> Review[supervised watchlist review]
    Review --> PromotionBoundary{promotion only<br/>no order execution}
    PromotionBoundary --> Pending[real order candidate<br/>approval_status=pending; Trade Gate gated]
    Pending --> TradeGate
    Research --> Picker[real picker candidates<br/>entry/take-profit/stop-loss targets]
    Picker ==> CapitalDB
    Picker -.->|no OCO or order side effects| TradeGate
    Research --> ModelProvenance[signal/candidate provenance<br/>runtime model or unavailable]
    ModelProvenance ==> CapitalDB
    QuoteService[QuoteService<br/>read-only market data] --> QuoteDecision[quorum or degraded decision]
    QuoteDecision --> CapitalDB[(sigmacapital.db)]
    TradeGate --> Approval[human approval and account binding]
    Approval --> RealGate[real-money authorization gate]
    RealGate --> AccountsTrading[AccountsTradingClient]
    AccountsTrading --> Schwab[Charles Schwab API]
    Schwab --> AccountContext[account balances and positions<br/>orders bounded to seven-day window]
    AccountContext --> Reconciliation[read-only production reconciliation]
    AccountContext -.->|order history failure: balances and positions retained; degraded completeness| Reconciliation
    Reconciliation --> NormalizedFacts[normalized broker orders and transactions]
    NormalizedFacts ==> CapitalDB
    Reconciliation --> ReconciliationRun[(reconciliation_runs)]
    ReconciliationRun --> FillFacts[(broker_fill_reconciliations)]
    ReconciliationRun --> Exclusions[(reconciliation_exclusions)]
    FillFacts --> RealizedPnL[realized position and P&L derivation]
    RealizedPnL --> PositionView
    CapitalDB --> Backup[authenticated backup and restore]
    Backup --> Restore[isolated validation before publication]
    TradeGate --> PositionView[position realization read-only view]
    PositionView -.->|cannot approve or execute| RealGate
    QuoteService -.->|excluded| RealGate
    CapitalDB -.->|parent details| MarketView[capital-derived-market-data]
    CapitalDB -.->|parent details| TradingView[capital-derived-trading-controls]
    CapitalDB -.->|parent details| PositionViewDetail[capital-derived-position-realization]
    class Tyler tyler
    class QuoteService,TradeGate,Approval,AccountsTrading,PositionView,Research,Discovery,Watchlist,Review,Picker,ModelProvenance,AccountContext,Reconciliation,NormalizedFacts,RealizedPnL orch
    class QuoteDecision,RealGate,Restore,PromotionBoundary state
    class CapitalDB,Pending,ReconciliationRun,FillFacts,Exclusions db
    class Schwab ext
    class Backup,MarketView,TradingView,PositionViewDetail ws
classDef tyler fill:#2a1a3a,stroke:#9e4aff,color:#fff
classDef orch fill:#1a3a52,stroke:#4a9eff,color:#fff
classDef ws fill:#1a3a30,stroke:#6ad4b4,color:#d0f8ee
classDef ext fill:#3a2020,stroke:#ff7a7a,color:#ffd0d0
classDef db fill:#3a3010,stroke:#d4c050,color:#f8f0c0
classDef state fill:#1a1a1a,stroke:#888888,color:#cccccc
