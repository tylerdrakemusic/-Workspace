%% Derived view of workspace-fr-flow.mmd: bounded TODO operational runtime and the
%% FR implementation anchor's child TODO coordination substates.
stateDiagram-v2
    IN_PROGRESS --> TODO_RUNTIME: operational TODO execution
    state "Bounded TODO operational runtime" as TODO_RUNTIME {
        [*] --> TODO_DISPATCH: /new-fr persists queued via todo_register_queued before dispatch
        TODO_DISPATCH --> TODO_CLAIM: todo_claim via workspace-coordination MCP
        TODO_CLAIM --> TODO_LEASE: durable claim returns lease
        TODO_LEASE --> TODO_OUTCOME: todo_heartbeat then todo_complete / todo_fail / todo_cancel via MCP
        TODO_OUTCOME --> [*]: terminal outcome persisted through workspace-coordination MCP
    }
    TODO_RUNTIME --> IN_PROGRESS: required children, artifacts, current parent head validated

    note right of TODO_RUNTIME
        todo_retry, todo_recover_stale, and approved todo_takeover use the same
        fixed workspace-coordination MCP allowlist and server policy.
        Arbitrary database and SQL arguments are rejected.
    end note

    %% Orthogonal execution-state contract for each admitted TODO.
    state "Canonical TODO execution states" as EXECUTION_STATES {
        [*] --> QUEUED
        QUEUED --> CLAIMED: valid claim accepted
        CLAIMED --> RUNNING: heartbeat accepted
        RUNNING --> COMPLETED: todo_complete with validated handoff and evidence
        RUNNING --> FAILED: execution failure
        CLAIMED --> STALE: lease expires
        RUNNING --> STALE: lease expires
        CLAIMED --> CANCELLED: valid cancellation
        RUNNING --> CANCELLED: valid cancellation
        FAILED --> QUEUED: explicit retry and budget remains
        STALE --> QUEUED: explicit retry and budget remains
        FAILED --> [*]: retry budget exhausted
        STALE --> [*]: retry budget exhausted
        COMPLETED --> [*]
        CANCELLED --> [*]
    }

    IN_PROGRESS --> FR_COORDINATION: FR anchor admits executable TODO 333
    state "FR implementation anchor · child TODO coordination" as FR_COORDINATION {
        [*] --> TODO_ADMISSION
        TODO_ADMISSION --> CHILD_ASSIGNED: FR match + executable TODO
        CHILD_ASSIGNED --> CLAIM_VALIDATED: claim/lifecycle validation boundary
        CLAIM_VALIDATED --> CHILD_WORK: isolated child branch + worktree
        CHILD_WORK --> SERIALIZED_INTEGRATION: child ready for integration
        SERIALIZED_INTEGRATION --> STALE_REBASE: child is stale
        STALE_REBASE --> SERIALIZED_INTEGRATION: rebase passes
        STALE_REBASE --> CONFLICT_HANDOFF: rebase conflict
        SERIALIZED_INTEGRATION --> CONFLICT_HANDOFF: integration conflict is coordination event
        CONFLICT_HANDOFF --> SERIALIZED_INTEGRATION: coordination resolved, execution state unchanged
        CONFLICT_HANDOFF --> CHILD_WORK: execution invalid, retry or rework required
        SERIALIZED_INTEGRATION --> CHILD_RETURN: integrate into FR feature branch
        CHILD_RETURN --> [*]: return to FR lifecycle; no gate bypass
    }
    FR_COORDINATION --> IN_PROGRESS: child handoff complete

    note right of FR_COORDINATION
        Parent aggregation reuses the existing parent_join_state precedence.
        Coordination conflicts remain events unless execution itself is invalid.
    end note

    class QUEUED,CLAIMED,RUNNING,COMPLETED,FAILED,STALE,CANCELLED state
    class TODO_ADMISSION,CHILD_ASSIGNED,CLAIM_VALIDATED,CHILD_WORK,SERIALIZED_INTEGRATION,STALE_REBASE,CONFLICT_HANDOFF,CHILD_RETURN state

