graph LR
    subgraph Maintenance["Explicit maintenance flow"]
        Caller[Operator]
        Plaintext[Caller-supplied plaintext rules<br/>source remains caller-owned]
        MaintenanceCLI[/deny-dangerous.ps1<br/>Maintenance mode/]
        TargetExists{Protected file exists?}
        OverwriteFlag{Explicit Overwrite?}
        RefuseOverwrite[Refuse replacement]
        Protect[.NET ProtectedData Protect<br/>CurrentUser]
        Ciphertext[(tools/dangerous-patterns.dpapi<br/>local ignored ciphertext)]
        Caller --> MaintenanceCLI
        Plaintext -->|supplied path| MaintenanceCLI
        MaintenanceCLI --> TargetExists
        TargetExists -->|no| Protect
        TargetExists -->|yes| OverwriteFlag
        OverwriteFlag -->|no| RefuseOverwrite
        OverwriteFlag -->|yes| Protect
        Protect -->|writes encrypted bytes| Ciphertext
    end
    subgraph Runtime["Command evaluation flow"]
        Command[Command input]
        RuntimeCLI[/deny-dangerous.ps1<br/>Runtime mode/]
        Unprotect[.NET ProtectedData Unprotect<br/>CurrentUser]
        Memory[Decrypted UTF-8 rules<br/>process memory only]
        Regex[.NET regex matching<br/>blank and comment lines skipped]
        MatchDecision{Rule matches?}
        Block[Generic block diagnostic<br/>matched rule omitted]
        Allow[Command allowed]
        Warning[Generic rules-unavailable warning<br/>command allowed]
        Command --> RuntimeCLI
        Ciphertext --> RuntimeCLI
        RuntimeCLI --> Unprotect
        Unprotect -->|success| Memory
        Unprotect -->|missing or failure| Warning
        Memory --> Regex
        Regex --> MatchDecision
        MatchDecision -->|yes| Block
        MatchDecision -->|no| Allow
    end
    subgraph PrewriteIntegrity["⊕ Pre-write integrity verification"]
        PrewriteGate[⊕workspace-overseer invokes<br/>prewrite_security_gate.py]
        ManifestVerifier[/update_manifest.py --verify/]
        IntegrityBlock[Block write<br/>unresolved mismatch or hard-block finding]
        IntegrityWarnAllow[Warning, allow write<br/>operationally incomplete]
        IntegrityAllow[Verification passed<br/>allow write]
        PrewriteGate --> ManifestVerifier
        ManifestVerifier -->|completed with mismatch or source drift| SkillDriftSummary
        ManifestVerifier -->|"invalid pin or verifier-level hard-block finding"| IntegrityBlock
        ManifestVerifier -->|start failure, timeout, or incomplete result| IntegrityWarnAllow
        ManifestVerifier -->|exit 0 with completion marker| IntegrityAllow
    end
    SkillDriftSummary[Reviewed skill updates, watched-file reconciliation, and quarantine<br/>see workspace-command-guard-skill-drift.mmd]
    Limitation[CurrentUser discourages casual inspection on this account and machine<br/>does not isolate same-user agents or prevent bypass]
    Protect -.-> Limitation
    Unprotect -.-> Limitation

    class Caller,MaintenanceCLI,RuntimeCLI,Command ws
    class PrewriteGate,ManifestVerifier ws
    class SkillDriftSummary ws
    class Plaintext ext
    class Protect,Unprotect,TargetExists,OverwriteFlag,MatchDecision,RefuseOverwrite,Limitation,IntegrityBlock,IntegrityWarnAllow,IntegrityAllow state
    class Ciphertext db
    class Memory,Regex,Block,Allow,Warning ws

    subgraph Legend["Legend"]
        direction LR
        L1[Workspace guard]:::ws
        L2[Caller-owned input]:::ext
        L3[(Local protected file)]:::db
        L4{Decision or boundary}:::state
    end

classDef tyler   fill:#3a1a52,stroke:#9e4aff,color:#fff
classDef orch    fill:#1a3a52,stroke:#4a9eff,color:#fff
classDef ws      fill:#2a4e3a,stroke:#4aff9e,color:#fff
classDef ext     fill:#4e2a2a,stroke:#ff4a4a,color:#fff
classDef db      fill:#4e4a2a,stroke:#ffe14a,color:#fff
classDef state   fill:#1a1a1a,stroke:#888,color:#fff
classDef ext      fill:#3a2020,stroke:#ff7a7a,color:#ffd0d0
classDef db       fill:#3a3010,stroke:#d4c050,color:#f8f0c0
classDef state    fill:#1a1a1a,stroke:#888888,color:#cccccc