%% Traceability.parent: diagrams/workspace-integrations.mmd
graph LR
    subgraph EntryPoints["⊕ Workspace entry points"]
        OverseerEntry[⊕ Overseer entry point]
        CIEntry[⊕ CI entry point]
    end
    subgraph ManifestBoundary["👁 AI-Manifest repository voice boundary"]
        ManifestMCP[mcp_server.py<br/>MCP registration boundary]
        SubmitRepositoryVoice[submit_repository_voice]
        RepositoryVoiceStatus[repository_voice_status<br/>credentials_exposed=false]
        RepositoryVoiceInjection[RepositoryVoiceInjection<br/>injected governed capability]
        RepositoryVoiceBridge[governed_repository_voice.py<br/>Workspace callable bridge]
        VoiceWorker[AI-Manifest voice worker<br/>worker-only provider access]
        VoiceProvider{{ElevenLabs provider}}
    end
    ExplicitAuthorization{explicit authorization<br/>repository_voice_authorized}
    StableDecisionID[stable decision ID<br/>retry deduplication]
    BoundedTimeout[bounded timeout]
    TTSQueue[(tts_queue<br/>durable queue)]
    FailOpenText[fail-open text result<br/>workflow result unchanged]
    FailOpenDiagnostics[fail-open diagnostics<br/>voice_status and voice_error]

    OverseerEntry --> ExplicitAuthorization
    CIEntry --> ExplicitAuthorization
    ExplicitAuthorization -->|authorized| RepositoryVoiceInjection
    ExplicitAuthorization -->|unauthorized| FailOpenText
    RepositoryVoiceInjection --> RepositoryVoiceBridge
    RepositoryVoiceBridge --> SubmitRepositoryVoice
    ManifestMCP --> SubmitRepositoryVoice
    ManifestMCP --> RepositoryVoiceStatus
    SubmitRepositoryVoice ==> TTSQueue
    SubmitRepositoryVoice --> StableDecisionID
    SubmitRepositoryVoice --> BoundedTimeout
    BoundedTimeout -->|timeout| FailOpenText
    BoundedTimeout -.-> FailOpenDiagnostics
    TTSQueue -.->|durable output| VoiceWorker
    VoiceWorker --> VoiceProvider
    VoiceWorker -->|synthesis or playback failure| FailOpenText
    RepositoryVoiceStatus -.->|status semantics| FailOpenDiagnostics

    class OverseerEntry,CIEntry ws
    class ManifestMCP,SubmitRepositoryVoice,RepositoryVoiceStatus,RepositoryVoiceInjection,RepositoryVoiceBridge,VoiceWorker manifest
    class VoiceProvider ext
    class ExplicitAuthorization,BoundedTimeout,FailOpenText,FailOpenDiagnostics state
    class StableDecisionID ws
    class TTSQueue db

