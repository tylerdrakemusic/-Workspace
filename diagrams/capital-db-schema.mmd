        integer id PK
        text symbol
        text data_type
        text payload
        text fetched_at
    }
    PORTFOLIO_VALUE_HISTORY {
        integer id PK
        text captured_at
        real portfolio_value
        real buying_power
        real total_value
    }
    SIGNALS {
        integer id PK
        text source
        text symbol
        text payload
        text captured_at
        text category
        text batch_id
    }
    RISK_THRESHOLDS {
        integer id PK
        text dimension
        real threshold
        text updated_at
    }
