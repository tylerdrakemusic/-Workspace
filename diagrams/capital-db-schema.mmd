erDiagram
    TRADE_CANDIDATES ||--o{ EXECUTION_HISTORY : generates
    TRADE_CANDIDATES ||--o{ EXITS : creates_entry_exit
    PORTFOLIO ||--o{ EXITS : has_exit
    EXITS ||--o{ EXITS : supersedes
    TRADE_CANDIDATES ||--o{ REAL_MONEY_CONFIRMATIONS : audits
    TRADE_CANDIDATES ||--o{ MARGIN_RESERVATIONS : reserves_candidate_account
    RISK_THRESHOLDS ||--o{ TRADE_CANDIDATES : qualifies
    SENTIMENT_SHADOW_RUNS ||--o{ SENTIMENT_VALIDATION_EVALUATIONS : groups_by_run_id
    HOLDINGS_SNAPSHOTS ||--o{ POSITION_HOLDINGS : "enforced FK contains"
    HOLDINGS_SNAPSHOTS ||--o{ POSITION_REVIEWS : "enforced FK feeds; UNIQUE snapshot"
    POSITION_REVIEWS ||--o{ POSITION_PROPOSAL_DRAFTS : "enforced FK produces"

    PORTFOLIO {
        integer id PK
        text symbol
        real shares
        real avg_cost
        text opened_at
        text model
    }
    ACCOUNT_STATE {
        text key PK
        real value
        text updated_at
    }
    EXECUTION_HISTORY {
        integer id PK
        date week_of
        text symbol
        text side "buy|sell"
        real entry_target
        real exit_target
        real stop_loss_target
        text rationale
        real confidence
        text created_at
        text status
        text risk_reason
        text unit
        real quantity
        text order_type
        real limit_price
        real stop_price
        real trailing_amount
        text trailing_amount_type
        text timing
        text execution_certainty
        text mode "simulated|real"
        real estimated_cost
        text model
        text scoring_method
        text broker_order_id
        text broker_status "nightly-synced from Schwab"
        text broker_error
        text placement_warnings "JSON array"
        text account_ref
        text margin_label "cash|overnight-margin"
        real margin_borrowed_amount
        real margin_composite_score
        text margin_account_proof_at
        integer margin_ui_acknowledged "0|1"
        text margin_recheck_date
        real margin_buying_power
        real margin_cash_balance
    }
    MARKET_DATA_CACHE {
        integer id PK
        text symbol
        text data_type
        text payload
        text fetched_at
    }
    PORTFOLIO_VALUE_HISTORY {
        integer id PK
        text captured_at
        real portfolio_value
        real buying_power
        real total_value
    }
    SIGNALS {
        integer id PK
        text source
        text symbol
        text payload "sentiment_context JSON; normalized metadata; no provider transcript"
        text captured_at
        text category
        text batch_id
        text sentiment "normalized polarity: bullish|bearish|neutral"
        text citations "JSON array of citation URLs"
    }
    RISK_THRESHOLDS {
        integer id PK
        text dimension "qualification_score seeded"
        real threshold "default 7.0"
        text updated_at
    }
    TRADE_CANDIDATES {
        integer id PK
        date week_of
        text symbol
        text side "buy|sell"
        real entry_target
        real exit_target
        real stop_loss_target
        text ai_reason
        real confidence "derived picker confidence"
        text rationale "provider or fallback rationale"
        text scoring_method "perplexity|heuristic"
        text mode "simulated|real"
        text created_at
        text model
        text approval_account_ref "selected account persisted at approval"
        text margin_label "cash|overnight-margin"
        real margin_borrowed_amount
        real margin_composite_score
        text margin_account_proof_at
        integer margin_ui_acknowledged "0|1"
        text margin_recheck_date
        real margin_buying_power
        real margin_cash_balance
    }
    EXITS {
        integer id PK
        integer position_id FK
        text symbol
        text account_ref
        text direction "long|short"
        real entry_price
        real atr
        real stop_loss_price
        real take_profit_price
        real quantity
        text status "active|superseded|triggered|cancelled"
        integer supersedes_id FK
        integer version
        text reason
        text created_at
    }

    %% EXITS (FR-20260704): per-position exit strategy rows — ATR-based stop/target,
    %% short-mirror direction support, supersede chain for re-evaluated thresholds,
    %% max-hold forced exit and partial/tranche closes tracked via version+status
    REAL_MONEY_CONFIRMATIONS {
        integer id PK
        integer candidate_id
        text account_ref
        text context
        text confirmed_at
        text margin_label "cash|overnight-margin"
        real margin_borrowed_amount
        real margin_composite_score
        text margin_account_proof_at
        integer margin_ui_acknowledged "0|1"
        text margin_recheck_date
        real margin_buying_power
        real margin_cash_balance
    }

    MARGIN_RESERVATIONS {
        integer id PK
        integer candidate_id FK "UNIQUE per candidate"
        text account_ref "selected/persisted Schwab account"
        real borrowed_amount "CHECK >= 0"
        text status "CHECK pending|consumed|released"
        text created_at "lifecycle timestamp"
        text released_at "lifecycle timestamp"
    }

    SENTIMENT_VALIDATION_EVALUATIONS {
        text run_id PK "composite key"
        text symbol PK "composite key"
        text captured_at PK "composite key"
        text payload "sanitized JSON; baseline/sentiment scores, ranks, deltas, provenance"
    }

    SENTIMENT_SHADOW_RUNS {
        text run_id PK
        text started_at
        text mode "shadow; immutable summary"
        text payload "sanitized evaluation summary JSON"
        text result_hash "SHA-256 of canonical payload"
    }

    SENTIMENT_ACTIVATION_DECISIONS {
        text decision_id PK
        text created_at
        text decision "PASS|BLOCKED"
        text payload "dataset, window, counts, calibration, failures, deltas, approval gate"
        text payload_hash "SHA-256 of canonical artifact"
    }

    HOLDINGS_SNAPSHOTS {
        text id PK
        text account_scope "CHECK dedicated"
        text captured_at
        text freshness_status "CHECK fresh|stale|unavailable"
        text error_message
        text account_binding "dedicated-account SHA-256 binding"
        text snapshot_fingerprint UK "UNIQUE normalized-holdings fingerprint"
    }
    POSITION_HOLDINGS {
        integer id PK
        text snapshot_id FK
        text symbol
        real quantity "normalized positive quantity"
        text direction "CHECK long|short; long↔buy, short↔sell"
        real market_value
        text freshness_status "CHECK fresh|stale|unavailable"
    }
    POSITION_REVIEWS {
        text id PK
        text snapshot_id FK "UNIQUE per snapshot"
        text status "CHECK pending_review|blocked|reviewed"
        integer review_only "CHECK = 1"
        text reason
        text created_at
    }
    POSITION_PROPOSAL_DRAFTS {
        integer id PK
        text source_review_id FK
        text symbol
        text action "CHECK loss_prevention|take_profit"
        real quantity
        real target_price "numeric CHECK > 0"
        text rationale
        integer version UK "UNIQUE(source_review_id, version)"
        text status "CHECK pending_review|superseded|reviewed"
        text created_at
    }

    %% sigmacapital.db — SQLCipher, key=SIGMACAPITAL_DB_KEY
    %% CHECK constraints enforce side ∈ {buy,sell} and mode ∈ {sim,real}
    %% mode='real' reserved for future FR after broker-API compliance review
    %% model column (FR-20260627): per-pick LLM provenance — legacy portfolio/execution rows backfilled to 'raptor', legacy candidates left NULL
    %% mode='real' authorized (charter amended, broker-API compliance review complete)
    %% for the single dedicated low-risk account; M2 live order placement ACTIVE
    %% (FR-20260801-sigmacapital-real-order-placement): broker_order_id / broker_error /
    %% placement_warnings capture the Schwab placement outcome per execution row
    %% (FR-20260808-sigmacapital-margin-aware-picker): margin columns are copied
    %% across candidate, execution, and confirmation audit rows; reservations are
    %% unique per candidate and retain release history instead of deleting rows.
    %% SIGNALS sentiment_context payload (existing signals table; no new entity):
    %% provider, model, symbol, polarity, score [-1,1], confidence [0,1],
    %% captured_at, citations, redacted source_metadata, request_id, batch_id,
    %% status {available|unavailable|error}, error_code, and provenance metadata.
    %% Provider transcripts are never persisted. Unavailable/error states are
    %% fail-open for ranking and contribute zero to the bounded additive score.
    %% Validation tables are separate from SIGNALS. The shadow-to-evaluation
    %% relationship is application-level grouping by run_id; the implementation
    %% does not declare SQL foreign keys. Activation decisions are independent
    %% immutable artifacts whose payload records the evaluated window and gates.
    %% FR-20260821 position realization: correlation to approved trade_candidates
    %% is application-level and requires a fresh dedicated-account snapshot plus
    %% an unambiguous exact-quantity match; stale/unavailable data fails closed.
    %% account_binding binds each snapshot to the dedicated account; the unique
    %% snapshot_fingerprint enables idempotent snapshot reuse. Foreign-key
    %% enforcement is enabled (PRAGMA foreign_keys=ON) and rejects orphan
    %% position_holdings, position_reviews, and position_proposal_drafts rows.
    %% position_reviews has UNIQUE(snapshot_id); position_proposal_drafts has
    %% UNIQUE(source_review_id, version). Direction compatibility is long/buy or
    %% short/sell. TRIGGER position_proposal_drafts_no_update aborts content or
    %% version changes; TRIGGER position_proposal_drafts_no_delete aborts every
    %% delete, preserving the append-only review-only proposal history.
