erDiagram
    TRADE_CANDIDATES ||--o{ EXECUTION_HISTORY : generates
    TRADE_CANDIDATES ||--o{ EXITS : creates_entry_exit
    PORTFOLIO ||--o{ EXITS : has_exit
    EXITS ||--o{ EXITS : supersedes
    TRADE_CANDIDATES ||--o{ REAL_MONEY_CONFIRMATIONS : audits

    PORTFOLIO {
        integer id PK
        text symbol
        real shares
        real avg_cost
        text opened_at
        text model
    }
    ACCOUNT_STATE {
        text key PK
        real value
        text updated_at
    }
    EXECUTION_HISTORY {
        integer id PK
        date week_of
        text symbol
        text side "buy|sell"
        text rationale
        real confidence
        text created_at
        text status
        text risk_reason
        text unit
        real quantity
        text order_type
        real limit_price
        real stop_price
        real trailing_amount
        text trailing_amount_type
        text timing
        text execution_certainty
        text mode "simulated|real"
        real estimated_cost
        text model
        text scoring_method
        text broker_order_id
        text broker_error
        text placement_warnings "JSON array"
    }
    MARKET_DATA_CACHE {
        integer id PK
        text symbol
        text data_type
        text payload
        text fetched_at
    }
    PORTFOLIO_VALUE_HISTORY {
        integer id PK
        text captured_at
        real portfolio_value
        real buying_power
        real total_value
    }
    SIGNALS {
        integer id PK
        text source
        text symbol
        text payload
        text captured_at
        text category
        text batch_id
    }
    RISK_THRESHOLDS {
        integer id PK
        text dimension
        real threshold
        text updated_at
    }
    TRADE_CANDIDATES {
        integer id PK
        date week_of
        text symbol
        text side "buy|sell"
        real entry_target
        real exit_target
        text ai_reason
        real scoring
        text mode "simulated|real"
        text created_at
        text model
    }
    EXITS {
        integer id PK
        integer position_id FK
        text symbol
        text account_ref
        text direction "long|short"
        real entry_price
        real atr
        real stop_loss_price
        real take_profit_price
        real quantity
        text status "active|superseded|triggered|cancelled"
        integer supersedes_id FK
        integer version
        text reason
        text created_at
    }

    %% EXITS (FR-20260704): per-position exit strategy rows — ATR-based stop/target,
    %% short-mirror direction support, supersede chain for re-evaluated thresholds,
    %% max-hold forced exit and partial/tranche closes tracked via version+status
    REAL_MONEY_CONFIRMATIONS {
        integer id PK
        integer candidate_id
        text account_ref
        text context
        text confirmed_at
    }

