    subgraph Workspace["⊕ Workspace Feature Request Board boundary"]
        FRDashboard[tools/fr_dashboard.py<br/>Feature Request Board + cycle-time chart<br/>parse_ledger + collect_all; active/archive grouping]
        FRRegistry[.github/FEATURE_REQUESTS.md<br/>FR registry]
        FRLedgerDir[.github/FR_LEDGERS/FR-*.md<br/>canonical FR ledgers + audit links]
        FRDashboardHTML[reports/fr_dashboard.html<br/>generated HTML artifact]
        FRServer[src/utils/fr_server.py<br/>refresh + serve boundary + GET /]
        subgraph CopilotConsumer["⊕ Supported Copilot cloud-agent consumer surface"]
            CopilotRoute[Metadata-only route inputs<br/>CachedInventory · select_model · shadow_replay]
            CopilotGate{{Live capability preflight<br/>official or extension-owned CloudAgentConsumer<br/>consume_cloud_agent}}
            CopilotTelemetry[Opaque ConsumerResult + TelemetryRecord<br/>observed accepted cost, then published pricing fallback<br/>persist_consumer_result → FR artifact boundary<br/>bounded metadata only]
            CopilotRoute --> CopilotGate
            CopilotGate -->|available| CopilotTelemetry
            CopilotGate -->|unavailable or delegation failure: not-activated / unavailable, fail closed| CopilotTelemetry
        end
    end
    FRRegistry -->|loads| FRDashboard
    FRLedgerDir -->|loads| FRDashboard
    FRDashboard ==>|generates| FRDashboardHTML
    FRServer -->|refreshes| FRDashboardHTML
    FRServer -->|serves at /| FRDashboardHTML

    subgraph GmailAttachments["⊕ Governed Gmail attachment capability"]
        GmailMCP[gmail_mcp_server.py<br/>stdio MCP boundary]
        GmailClient[gmail/client.py<br/>GmailServiceClient]
        GmailPolicy[gmail/policy.py<br/>ServiceEmailPolicy]
        GmailService{{Gmail service boundary}}
        ListAttachments[/list_attachments/]
        DownloadAttachment[/download_attachment/]
        ReadAuthorization{ATTACHMENTS<br/>read authorization}
        SizeGate{Attachment exceeds<br/>configured max?}
        OperatorApproval{Explicit operator<br/>approval required}
        AtomicWrite[tmp/gmail-attachments<br/>temp file + fsync + replace]
        RetentionCleanup[/30-day retention cleanup/]
        GmailMCP -->|list_attachments| ListAttachments
        GmailMCP -->|download_attachment| DownloadAttachment
        GmailMCP --> GmailClient
        GmailClient --> GmailPolicy
        ListAttachments --> ReadAuthorization
        DownloadAttachment --> ReadAuthorization
        ReadAuthorization -->|authorized read-only scope| GmailClient
        GmailClient --> GmailService
        DownloadAttachment --> SizeGate
        GmailPolicy --> ReadAuthorization
        GmailPolicy --> SizeGate
        SizeGate -->|within limit| AtomicWrite
        SizeGate -->|oversized| OperatorApproval
        OperatorApproval -->|operator_approved=True| AtomicWrite
        AtomicWrite ==> RetentionCleanup
        RetentionCleanup --> AtomicWrite
    end

    subgraph SecurityDashboardFlow["⊕ Security vulnerability dashboard"]
        SecurityConfig[dashboard.json<br/>security-vulns registration]
        SecurityLauncher[/open_security_dashboard.ps1<br/>launcher/]
        SecurityGenerator[tools/security_dashboard.py<br/>default --no-open generation<br/>load_all_vulns selects status = open]
        SecurityDB[(f:\⊕Workspace\src\data\workspace.db<br/>SQLCipher canonical DB<br/>vulnerabilities table)]
        SecurityHTML[reports/security_dashboard.html<br/>generated HTML artifact]
        SecurityShim[src/data/security_findings.json<br/>retired non-authoritative shim]
        SecurityConfig -->|declares generator and output| SecurityGenerator
        SecurityLauncher -->|invokes generator| SecurityGenerator
        SecurityDB -->|read-only SELECT of open rows| SecurityGenerator
        SecurityGenerator ==>|renders| SecurityHTML
        SecurityShim -.->|retired, not read| SecurityGenerator
    end

