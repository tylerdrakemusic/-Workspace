erDiagram
    BIOMARKERS ||--o{ MEASUREMENTS : tracks
    PROTOCOLS ||--o{ PROTOCOL_RUNS : executes
    BUDGET ||--o{ BUDGET_ENTRIES : contains
    NUTRITION ||--o{ MEALS : logs
    WORKOUT_SESSIONS ||--o{ WORKOUT_EXERCISES : contains

    BIOMARKERS {
        text marker PK
        text unit
        real target_low
        real target_high
    }
    MEASUREMENTS {
        integer id PK
        text marker FK
        real value
        text date
        text source
    }
    PROTOCOLS {
        text protocol_id PK
        text title
        text status
    }
    BUDGET {
        text category PK
        real monthly_target
    }
    WORKOUT_SESSIONS {
        integer id PK
        text date
        text source
        text title
        real duration_min
        real calories
    }
    WORKOUT_EXERCISES {
        integer id PK
        integer session_id FK
        text date
        text exercise_name
        integer sets
        integer reps
        real weight_kg
        real duration_sec
    }
    UPCOMING_WORKOUTS {
        integer id PK
        text date
        text week_start_date
        text source
        text name
        text scheduled_time
        real duration_min
        text difficulty
        text exercises_json
        text notes
        text synced_at
    }

    %% Constraints: UNIQUE(date, source, name)
    %% Index: (date, week_start_date)

    %% --- Monitoring ---
    SYNC_HEALTH {
        integer id PK
        text source
        text run_ts
        text status
        integer records_written
        text error_msg
    }
    SYNC_ALERTS {
        integer id PK
        text source
        text triggered_at
        text reason
        text resolved_at
    }
    TOKEN_REFRESH_LOG {
        integer id PK
        text provider
        text triggered_at
        text status
        integer expires_at
        real days_until_expiry
        text error_msg
    }