stateDiagram-v2
    [*] --> TRIAGED: Tyler opens FR
    TRIAGED --> BRANCHED: Tyler approves scope
    BRANCHED --> COMPLEXITY_ASSESSED: complexity_router.py
    COMPLEXITY_ASSESSED --> MCP_FIRST: deterministic MCP-first invocation
    MCP_FIRST --> IN_PROGRESS: governed coordination MCP available
    MCP_FIRST --> LOCAL_FALLBACK: MCP unavailable
    LOCAL_FALLBACK --> IN_PROGRESS: canonical local utilities only
    state "Bounded TODO operational runtime" as TODO_RUNTIME {
        [*] --> TODO_DISPATCH
        TODO_DISPATCH --> TODO_CLAIM: policy defaults 8 per FR / 16 global
        TODO_CLAIM --> TODO_LEASE: durable claim / lease / retry
        TODO_LEASE --> TODO_OUTCOME: allowlisted in-memory outcomes
        TODO_OUTCOME --> [*]
    }
    IN_PROGRESS --> TODO_RUNTIME: operational TODO execution
    TODO_RUNTIME --> IN_PROGRESS: required children, artifacts, current parent head validated
    IN_PROGRESS --> FR_COORDINATION: FR anchor admits executable TODO 333
    state "FR implementation anchor · child TODO coordination" as FR_COORDINATION {
        [*] --> TODO_ADMISSION
        TODO_ADMISSION --> CHILD_ASSIGNED: FR match + executable TODO
        CHILD_ASSIGNED --> CLAIM_VALIDATED: claim/lifecycle validation boundary
        CLAIM_VALIDATED --> CHILD_WORK: isolated child branch + worktree
        CHILD_WORK --> SERIALIZED_INTEGRATION: child ready for integration
        SERIALIZED_INTEGRATION --> STALE_REBASE: child is stale
        STALE_REBASE --> SERIALIZED_INTEGRATION: rebase passes
        STALE_REBASE --> CONFLICT_HANDOFF: rebase conflict
        SERIALIZED_INTEGRATION --> CONFLICT_HANDOFF: integration conflict
        CONFLICT_HANDOFF --> CHILD_WORK: preserve source + sibling work
        SERIALIZED_INTEGRATION --> CHILD_RETURN: integrate into FR feature branch
        CHILD_RETURN --> [*]: return to FR lifecycle; no gate bypass
    }
    FR_COORDINATION --> IN_PROGRESS: child handoff complete
    IN_PROGRESS --> PARENT_JOIN_EVALUATION: implementation done
    state "Evidence-backed parent join gate" as PARENT_JOIN_EVALUATION {
        [*] --> PARENT_JOIN_EVALUATOR
        PARENT_JOIN_EVALUATOR --> PARENT_JOIN_EVIDENCE: parent_join_gates.evaluate_parent_join
        PARENT_JOIN_EVIDENCE --> PARENT_JOIN_RECOMPUTE: persist parent-join-evidence
        PARENT_JOIN_RECOMPUTE --> PARENT_JOIN_PASS: recompute against latest evidence
        PARENT_JOIN_RECOMPUTE --> PARENT_JOIN_BLOCKED: missing, stale, or mismatched evidence
        PARENT_JOIN_PASS --> [*]: accept PARENT_JOIN:PASS
        PARENT_JOIN_BLOCKED --> [*]: reject PARENT_JOIN:PASS
    }
    PARENT_JOIN_EVALUATION --> FUNCTIONAL_QA: PARENT_JOIN:PASS accepted
    PARENT_JOIN_EVALUATION --> IN_PROGRESS: PARENT_JOIN:PASS blocked
    FUNCTIONAL_QA --> FUNCTIONAL_QA: blocked until parent join passes
    FUNCTIONAL_QA --> ARCHITECTURE_REVIEW: QA PASS
    FUNCTIONAL_QA --> IN_PROGRESS: QA FAIL / CHANGES_REQUESTED
    ARCHITECTURE_REVIEW --> ARCHITECTURE_REVIEW: STALE/MISSING → beautifier → re-verify
    ARCHITECTURE_REVIEW --> REVIEW_REQUESTED: PASS / PASS_WITH_UPDATES
    REVIEW_REQUESTED --> AUTO_REVIEWED: ⊕workspace-reviewer
    AUTO_REVIEWED --> TYLER_APPROVED: Tyler approves PR
    TYLER_APPROVED --> COST_GATE: ⊕workspace-ci validates cost outcome
    COST_GATE --> COST_ESTIMATED: estimated
    COST_GATE --> COST_UNAVAILABLE: unavailable + reason/source recorded
    COST_GATE --> MERGE_BLOCKED: NULL or pending
    COST_ESTIMATED --> MERGED: ⊕workspace-ci merges
    COST_UNAVAILABLE --> MERGED: ⊕workspace-ci merges
    MERGE_BLOCKED --> COST_GATE: outcome recorded
    MERGED --> SOAKING: post-merge soak window
    SOAKING --> SIGNED_OFF: signoff verified
    SIGNED_OFF --> [*]

    note right of FUNCTIONAL_QA
        Parent-join evidence blocks FUNCTIONAL_QA,
        ARCHITECTURE_REVIEW, TYLER_APPROVED, MERGED,
        SOAKING, and SIGNED_OFF until recomputation accepts
        PARENT_JOIN:PASS.
    end note

    AUTO_REVIEWED --> IN_PROGRESS: changes requested

    class MCP_FIRST,LOCAL_FALLBACK,TODO_ADMISSION,CHILD_ASSIGNED,CLAIM_VALIDATED,CHILD_WORK,SERIALIZED_INTEGRATION,STALE_REBASE,CONFLICT_HANDOFF,CHILD_RETURN state

