classDef ws      fill:#2a4e3a,stroke:#4aff9e,color:#fff
classDef ext     fill:#4e2a2a,stroke:#ff4a4a,color:#fff
classDef db      fill:#4e4a2a,stroke:#ffe14a,color:#fff
