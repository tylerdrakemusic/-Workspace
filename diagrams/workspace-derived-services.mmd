%% Traceability.parent: diagrams/workspace-architecture.mmd
graph LR
    subgraph Control["⊕ Resident portal control plane"]
        Shims[PowerShell · VBS · portal protocol<br/>thin compatibility shims]
        Supervisor[portal_supervisor.py<br/>sole 127.0.0.1:8790 owner<br/>operation lock · optional regen after bind]
        Portal[portal.html<br/>synchronous shell · no-store<br/>quiesce then active-generation readiness reload]
        Config[portal_servers.json<br/>command · cwd · port · enabled<br/>Trade Gate /health readiness<br/>Executive exact root · cache bust disabled]
        RuntimeState[(lock-synchronized snapshots<br/>PID · command · cwd · started time<br/>generation · readiness · attempt · error)]
        Logs[(generation-scoped stdout/stderr<br/>deterministic latest ten<br/>current generation preserved)]
    end
    subgraph Lifecycle["Configured service lifecycle"]
        Reclaim[fail-closed configured-port reclamation<br/>inspect · terminate · verify absent]
        Pool[three-worker startup pool]
        Launch[exact configured command<br/>shell=false]
        Readiness[HTTP readiness<br/>30-second attempt deadline]
        AutoRetry[one automatic retry]
        ManualRetry[manual per-service retry<br/>active generation · overlap returns 409]
    end
    subgraph Projects["Local portal services"]
        Life[∞ Life services]
        Music[❤ Music services]
        Quantum[⟨ψ⟩ Quantum services]
        Manifest[👁 AI-Manifest services]
        Capital[Σ Capital services]
        WorkspaceServices[⊕ Workspace services]
    end
    subgraph External["External services"]
        OpenAI[OpenAI]
        FlyIO[Fly.io]
        IBMQ[IBM Quantum]
        HF[Hugging Face]
        Pollinations[Pollinations.AI]
        ElevenLabs[ElevenLabs]
        Perplexity[Perplexity.ai]
        Schwab[Charles Schwab API]
        GDrive[Google Drive]
        Gmail[Gmail service]
    end

    Shims -->|all launch and restart paths dispatch only| Supervisor
    Config ==> Supervisor
    Supervisor -->|GET portal · applyGeneration refreshes loaded compatible frames| Portal
    Portal -->|GET synchronized state| Supervisor
    Portal -->|POST with loopback Host + matching Origin + rotating CSRF| Supervisor
    Portal -->|POST retry under shared operation lock| ManualRetry
    Supervisor -->|focus browser on current generation| Portal
    Supervisor ==> RuntimeState
    Supervisor ==> Logs
    Supervisor --> Reclaim --> Pool --> Launch --> Readiness
    Readiness -->|first attempt failed| AutoRetry --> Reclaim
    Readiness -->|ready or second failure| RuntimeState
    ManualRetry --> Reclaim
    Launch --> Life & Music & Quantum & Manifest & Capital & WorkspaceServices

    WorkspaceServices --> OpenAI
    Life -->|llm research| OpenAI
    Music -->|CI-deployed cloud host: guitartrainer.fly.dev| FlyIO
    Quantum -->|qiskit jobs| IBMQ
    WorkspaceServices --> HF
    WorkspaceServices --> Pollinations
    WorkspaceServices --> ElevenLabs
    WorkspaceServices --> Perplexity
    WorkspaceServices --> Schwab
    WorkspaceServices --> GDrive
    WorkspaceServices --> Gmail
    Quantum -.->|QRNG entropy| WorkspaceServices
    Capital -.->|research and audit events| WorkspaceServices
    Manifest -.->|briefs and roadmap| WorkspaceServices

